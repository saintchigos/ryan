# Copy to server/.env and fill in.

PORT=4000
RYAN_CLIENT_ORIGINS=*

# Shared secret that protects every sensitive API route. STRONGLY recommended
# in production. The client sends it as VITE_API_TOKEN.
RYAN_API_TOKEN=

# --- Brain (any OpenAI-compatible endpoint) -----------------------
RYAN_LLM_API_KEY=
RYAN_LLM_BASE_URL=https://api.openai.com/v1
RYAN_LLM_MODEL=gpt-4o-mini
RYAN_LLM_TEMPERATURE=0.7

# Optional: host your own agent here (takes priority over the LLM above)
RYAN_AGENT_ENDPOINT=

# Optional: better web search (keyless DuckDuckGo is used otherwise)
TAVILY_API_KEY=
BRAVE_API_KEY=

# Optional
RYAN_SYSTEM_PROMPT=
RYAN_MAX_TOOL_ROUNDS=10
RYAN_DATA_DIR=

# --- Phone calls + SMS (Twilio) -----------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Smart home (Home Assistant) ----------------------------------
# Create a long-lived access token in your HA profile.
HOME_ASSISTANT_URL=
HOME_ASSISTANT_TOKEN=

# --- Calendar -----------------------------------------------------
# Read: any ICS feed (e.g. Google Calendar "secret address in iCal format").
CALENDAR_ICS_URL=
# Read AND write: a CalDAV calendar collection URL.
CALDAV_URL=
CALDAV_USER=
CALDAV_PASSWORD=

# --- Email (IMAP read + SMTP send) --------------------------------
EMAIL_IMAP_HOST=
EMAIL_IMAP_PORT=993
EMAIL_IMAP_SECURE=true
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=465
EMAIL_SMTP_SECURE=true
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=

# --- Device control bridge ----------------------------------------
# Long random string. The device agent must send the same value to pair.
DEVICE_PAIRING_SECRET=
DEVICE_POLL_TIMEOUT_MS=20000
DEVICE_COMMAND_TIMEOUT_MS=45000
