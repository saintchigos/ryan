# ------------------------------------------------------------------
# Ryan environment reference. The server reads server/.env - see
# server/.env.example for the file you actually copy.
# ------------------------------------------------------------------

# --- Server -------------------------------------------------------
PORT=4000
RYAN_CLIENT_ORIGINS=*
RYAN_API_TOKEN=

RYAN_LLM_API_KEY=
RYAN_LLM_BASE_URL=https://api.openai.com/v1
RYAN_LLM_MODEL=gpt-4o-mini
RYAN_AGENT_ENDPOINT=
TAVILY_API_KEY=
BRAVE_API_KEY=
RYAN_MAX_TOOL_ROUNDS=10

# --- Phone calls + SMS --------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Smart home ---------------------------------------------------
HOME_ASSISTANT_URL=
HOME_ASSISTANT_TOKEN=

# --- Calendar -----------------------------------------------------
CALENDAR_ICS_URL=
CALDAV_URL=
CALDAV_USER=
CALDAV_PASSWORD=

# --- Email --------------------------------------------------------
EMAIL_IMAP_HOST=
EMAIL_IMAP_PORT=993
EMAIL_IMAP_SECURE=true
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=465
EMAIL_SMTP_SECURE=true
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=

# --- Device control -----------------------------------------------
DEVICE_PAIRING_SECRET=

# --- Client (set in Vercel, not here) -----------------------------
# VITE_API_URL=https://your-ryan-server.onrender.com
# VITE_API_TOKEN=same-as-RYAN_API_TOKEN
